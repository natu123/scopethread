# CockroachDB connection string. Never commit a real credential.
DATABASE_URL=

# AWS configuration.
AWS_REGION=ap-southeast-1
AWS_PROFILE=scopethread-dev

# Cost-efficient Amazon model accessed through global cross-region inference.
BEDROCK_CHAT_MODEL_ID=global.amazon.nova-2-lite-v1:0

# Multilingual 1024-dimensional embedding model.
BEDROCK_EMBEDDING_MODEL_ID=cohere.embed-multilingual-v3

# Browser API endpoint after deployment.
VITE_API_BASE_URL=
